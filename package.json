{
  "name": "robot-math-lab",
  "version": "1.1.0",
  "private": true,
  "description": "Robot Math Lab - frontend + Vercel Functions auth/access tracking",
  "scripts": {
    "dev": "vercel dev",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "user:reset-password": "node scripts/reset-password.mjs",
    "build:3d": "esbuild js/simulation-3d.js --bundle --format=esm --minify --target=es2020 --outfile=js/simulation-3d.bundle.js",
    "test": "node --test tests/password.test.mjs tests/validate.test.mjs tests/kinematics.test.mjs tests/3d-bundle.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "postgres": "^3.4.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.187.0"
  }
}
