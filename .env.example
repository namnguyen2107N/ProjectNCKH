# Robot Math Lab - Environment Configuration Example
# Copy to .env.local (local) and set the same keys in Vercel Project Settings.
# NEVER commit real secrets.

# --- Existing static dev server (serve.js) ---
PORT=3000

# --- Neon Postgres ---
# Runtime: use the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Scripts/migrations: use the DIRECT (non-pooler) connection string.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Set to false only for a local Postgres without SSL.
DATABASE_SSL=true

# --- Auth / access tracking ---
# Public origin of the site (used for links and same-origin checks).
APP_ORIGIN=https://robotmathlab.vercel.app
# Random 32+ byte string. Used to hash IP addresses; do not change after data collection starts.
IP_HASH_PEPPER=replace-with-a-long-random-string
# Student session lifetime.
SESSION_TTL_HOURS=12
# Consent version shown/stored at registration.
CONSENT_VERSION=2026-10-v1
# Monitoring threshold shown on the admin dashboard (does not block logins).
MAX_ONLINE_ALERT=100

# --- Seed script (optional, used by `npm run db:seed` only) ---
ADMIN_USERNAME=admin
# If omitted, the seed script generates a random password and prints it once.
# ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Quản trị viên
CLASS_NAME=Lớp Demo
# If omitted, a random class code is generated and printed.
# CLASS_CODE=
# TEACHER_USERNAME=
# TEACHER_PASSWORD=
